@{
    Layout = "_Layout";
    ViewData["Title"] = "דף הבית";
}

<style>
    .hero {
        text-align: center;
        padding: 5rem 1.5rem 4rem;
        max-width: 700px;
        margin: 0 auto;
    }

    .hero-label {
        display: inline-block;
        background: #fff3f0;
        color: var(--accent);
        border: 1px solid #fdc5b4;
        border-radius: 20px;
        padding: 0.3rem 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 1.5rem;
    }

    .hero h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 1.25rem;
        letter-spacing: -1px;
    }

    .hero h1 span { color: var(--accent); }

    .hero p {
        font-size: 1.15rem;
        color: var(--muted);
        line-height: 1.7;
        margin-bottom: 2.5rem;
    }

    .hero-cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }

    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
        padding: 0 1.5rem 4rem;
        max-width: 960px;
        margin: 0 auto;
    }

    .feature-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.75rem;
    }

    .feature-icon {
        font-size: 2rem;
        margin-bottom: 0.75rem;
    }

    .feature-card h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .feature-card p {
        font-size: 0.9rem;
        color: var(--muted);
        line-height: 1.6;
    }

    .levels {
        background: var(--ink);
        padding: 3rem 1.5rem;
        margin: 0 0 4rem;
    }

    .levels-inner {
        max-width: 960px;
        margin: 0 auto;
        text-align: center;
    }

    .levels h2 {
        color: var(--white);
        font-size: 1.75rem;
        font-weight: 900;
        margin-bottom: 0.5rem;
    }

    .levels-sub { color: #888; margin-bottom: 2rem; font-size: 0.95rem; }

    .levels-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .level-box {
        border-radius: 10px;
        padding: 1.5rem 1rem;
        text-align: center;
    }

    .level-easy { background: #0d2b14; border: 1px solid #1a4a20; }
    .level-medium { background: #2b2000; border: 1px solid #4a3800; }
    .level-hard { background: #2b0a0a; border: 1px solid #4a1010; }

    .level-box .emoji { font-size: 1.75rem; margin-bottom: 0.5rem; }
    .level-easy .label { color: #4ade80; font-weight: 700; }
    .level-medium .label { color: #facc15; font-weight: 700; }
    .level-hard .label { color: #f87171; font-weight: 700; }
    .level-box p { font-size: 0.8rem; color: #777; margin-top: 0.25rem; }
</style>

<div class="hero">
    <div class="hero-label">✦ מופעל על ידי Claude AI</div>
    <h1>שאלות בחינה<br><span>נבנות אוטומטית</span><br>עבורך</h1>
    <p>הכנס נושאים — קבל שאלות ברמות קל, בינוני וקשה. התשובות מוצגות לאחר 48 שעות.</p>
    <div class="hero-cta">
        <a href="/Auth/Register" class="btn btn-primary">התחל עכשיו ←</a>
        <a href="/Auth/Login" class="btn btn-secondary">יש לי חשבון</a>
    </div>
</div>

<div class="levels">
    <div class="levels-inner">
        <h2>שלוש רמות קושי</h2>
        <p class="levels-sub">כל נושא מקבל שאלות בכל רמה</p>
        <div class="levels-grid">
            <div class="level-box level-easy">
                <div class="emoji">🟢</div>
                <div class="label">קל</div>
                <p>מושגים בסיסיים</p>
            </div>
            <div class="level-box level-medium">
                <div class="emoji">🟡</div>
                <div class="label">בינוני</div>
                <p>הבנה ויישום</p>
            </div>
            <div class="level-box level-hard">
                <div class="emoji">🔴</div>
                <div class="label">קשה</div>
                <p>ניתוח וחשיבה</p>
            </div>
        </div>
    </div>
</div>

<div class="features">
    <div class="feature-card">
        <div class="feature-icon">🧠</div>
        <h3>AI חכם</h3>
        <p>שאלות נוצרות על ידי Claude AI — מדויקות, מגוונות ומותאמות לנושא</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">⏱️</div>
        <h3>תשובות לאחר 48 שעות</h3>
        <p>מספיק זמן ללמוד לבד לפני שהתשובות נחשפות — מעודד למידה אמיתית</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">📚</div>
        <h3>כל נושא</h3>
        <p>מדעים, היסטוריה, תכנות, משפטים — הכנס כל נושא שתרצה</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">💡</div>
        <h3>הסברים מפורטים</h3>
        <p>כל תשובה מגיעה עם הסבר מלא שמסביר למה היא נכונה</p>
    </div>
</div>
