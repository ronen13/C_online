@model QuizSystem.Models.LoginViewModel
@{ Layout="_Layout"; ViewData["Title"]="התחברות"; }
<style>
    .auth-wrap { min-height:calc(100vh - 64px); display:flex; align-items:center; justify-content:center; padding:3rem 1rem; background:var(--gray-50); }
    .auth-box { width:100%; max-width:400px; }
    .auth-card { background:var(--white); border:1px solid var(--gray-200); border-radius:16px; padding:2.5rem; }
    .auth-logo { height:32px; display:block; margin:0 auto 1.75rem; }
    .auth-card h1 { font-size:1.5rem; font-weight:900; color:var(--gray-900); margin-bottom:0.3rem; text-align:center; }
    .auth-sub { color:var(--gray-500); font-size:0.85rem; text-align:center; margin-bottom:1.75rem; }
    .auth-link { text-align:center; margin-top:1rem; font-size:0.85rem; color:var(--gray-500); }
    .auth-link a { color:var(--teal); font-weight:600; text-decoration:none; }
    .submit-btn { width:100%; padding:0.75rem; font-size:0.95rem; border-radius:8px; border:none; background:var(--teal); color:var(--white); font-family:'Heebo',sans-serif; font-weight:700; cursor:pointer; transition:background 0.15s; }
    .submit-btn:hover { background:var(--teal-dark); }
</style>
<div class="auth-wrap">
    <div class="auth-box">
        <div class="auth-card">
            <img src="/images/logo.png" class="auth-logo" alt="MarketClab" style="filter:sepia(1) hue-rotate(120deg) saturate(0.8);" />
            <h1>התחברות</h1>
            <p class="auth-sub">ברוך שובך!</p>
            @if(ViewBag.Error!=null){<div class="alert alert-error">@ViewBag.Error</div>}
            <form method="post">
                <div class="form-group"><label>אימייל</label><input type="email" name="Email" placeholder="name@example.com" required /></div>
                <div class="form-group"><label>סיסמה</label><input type="password" name="Password" placeholder="••••••" required /></div>
                <button type="submit" class="submit-btn">כניסה ←</button>
            </form>
        </div>
        <div class="auth-link">אין לך חשבון? <a href="/Auth/Register">הרשמה חינמית</a></div>
    </div>
</div>
