@{
    Layout="_Layout"; ViewData["Title"]="תשלום";
    var session = ViewBag.Session as QuizSystem.Models.QuizSession;
}
<style>
    .pay-wrap { min-height:calc(100vh - 64px); display:flex; align-items:center; justify-content:center; padding:3rem 1rem; background:var(--gray-50); }
    .pay-card { width:100%; max-width:440px; background:var(--white); border:1px solid var(--gray-200); border-radius:16px; overflow:hidden; }
    .pay-header { background:var(--black); padding:1.75rem; text-align:center; }
    .pay-header h2 { color:var(--white); font-size:1.2rem; font-weight:700; margin-bottom:0.25rem; }
    .pay-header p { color:var(--gray-500); font-size:0.82rem; }
    .pay-body { padding:1.75rem; }
    .pay-row { display:flex; justify-content:space-between; padding:0.5rem 0; font-size:0.875rem; color:var(--gray-600); border-bottom:1px solid var(--gray-100); }
    .pay-row:last-of-type { border-bottom:none; }
    .pay-total { display:flex; justify-content:space-between; padding:0.75rem 0 1.5rem; font-weight:700; font-size:1rem; color:var(--gray-900); border-top:2px solid var(--gray-200); margin-top:0.5rem; }
    .pay-total .price-big { font-size:1.5rem; font-weight:900; color:var(--teal); }
    .demo-note { background:var(--blue-pale); border:1px solid #bfdbfe; border-radius:8px; padding:0.7rem 1rem; font-size:0.78rem; color:#1e40af; margin-bottom:1.25rem; }
    .pay-btn { width:100%; padding:0.8rem; background:var(--teal); color:var(--white); border:none; border-radius:8px; font-family:'Heebo',sans-serif; font-size:1rem; font-weight:700; cursor:pointer; transition:background 0.15s; }
    .pay-btn:hover { background:var(--teal-dark); }
</style>
<div class="pay-wrap">
    <div class="pay-card">
        <div class="pay-header">
            <h2>💳 השלמת תשלום</h2>
            <p>MarketClab Quiz — 100 שאלות C#</p>
        </div>
        <div class="pay-body">
            <div class="demo-note">ℹ️ <strong>מצב הדגמה</strong> — בייצור יועבר למשולם</div>
            <div class="pay-row"><span>נושאים</span><span style="color:var(--gray-800);font-size:0.8rem;max-width:220px;text-align:left;">@(session?.Topics.Length>50?session.Topics[..50]+"…":session?.Topics)</span></div>
            <div class="pay-row"><span>100 שאלות (34/33/33)</span><span>₪99.00</span></div>
            <div class="pay-row"><span>מע"מ 17%</span><span>₪16.83</span></div>
            <div class="pay-total"><span>סה"כ</span><span class="price-big">₪115.83</span></div>
            <form method="post" action="/Quiz/ConfirmPayment">
                <input type="hidden" name="id" value="@session?.Id" />
                <button type="submit" class="pay-btn">אשר תשלום (הדגמה) ←</button>
            </form>
        </div>
    </div>
</div>
