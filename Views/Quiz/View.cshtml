@model QuizSystem.Models.QuizResultViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "בחן";
    var answersAt = Model.Session.AnswersAvailableAt;
}
<style>
    .quiz-header { background: var(--green-deep); padding: 2.5rem 1.5rem; color: var(--white); }
    .quiz-header-inner { max-width: 960px; margin: 0 auto; }
    .quiz-header h1 { font-size: 1.6rem; font-weight: 900; margin-bottom: 0.3rem; }
    .quiz-meta { color: #8ecfaa; font-size: 0.82rem; margin-bottom: 1rem; }
    .topics-tag { display:inline-block; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:#d4edda; border-radius:20px; padding:0.2rem 0.7rem; font-size:0.78rem; margin:0.2rem; }
    .countdown-box { background:rgba(0,0,0,0.25); border:1px solid var(--teal); border-radius:10px; padding:1rem 1.5rem; display:flex; align-items:center; justify-content:space-between; max-width:480px; margin-top:1rem; }
    .countdown-box .lbl { color:#8ecfaa; font-size:0.82rem; }
    .countdown-timer { font-size:1.6rem; font-weight:900; color:#4ade80; font-variant-numeric:tabular-nums; }
    .answers-unlocked { background:rgba(22,163,74,0.2); border:1px solid #16a34a; border-radius:10px; padding:1rem 1.5rem; color:#4ade80; font-weight:700; display:flex; align-items:center; gap:0.5rem; margin-top:1rem; max-width:480px; }

    .section-title { display:flex; align-items:center; gap:0.75rem; font-size:1.1rem; font-weight:900; margin:2rem 0 1rem; color:var(--green-deep); }
    .q-card { background:var(--white); border:1px solid var(--border); border-radius:12px; padding:1.5rem; margin-bottom:1rem; }
    .q-num { font-size:0.75rem; color:var(--text-muted); font-weight:700; margin-bottom:0.4rem; }
    .q-text { font-size:1rem; font-weight:500; margin-bottom:1rem; line-height:1.6; color:var(--text-main); }
    .options { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; }
    .option { padding:0.6rem 0.85rem; border-radius:8px; border:1.5px solid var(--border); font-size:0.875rem; display:flex; gap:0.5rem; align-items:flex-start; line-height:1.4; background:var(--bg-light); }
    .option-key { font-weight:700; min-width:18px; color:var(--text-muted); }
    .option.correct { border-color:#16a34a; background:#f0fdf4; }
    .option.correct .option-key { color:#16a34a; }
    .explanation { margin-top:1rem; padding:0.75rem 1rem; background:#e8f5ee; border-right:3px solid var(--teal); border-radius:0 8px 8px 0; font-size:0.875rem; color:var(--green-dark); line-height:1.6; }
    .locked-msg { background:var(--bg-light); border:1.5px dashed var(--border); border-radius:8px; padding:0.75rem 1rem; font-size:0.8rem; color:var(--text-muted); text-align:center; margin-top:0.75rem; }
</style>

<div class="quiz-header">
    <div class="quiz-header-inner">
        <h1>📝 @(Model.Session.Topics.Length > 60 ? Model.Session.Topics[..60] + "..." : Model.Session.Topics)</h1>
        <div class="quiz-meta">
            נוצר: @Model.Session.CreatedAt.ToString("dd/MM/yyyy HH:mm") ·
            @(Model.EasyQuestions.Count + Model.MediumQuestions.Count + Model.HardQuestions.Count) שאלות
        </div>
        <div>
            @foreach (var t in Model.Session.Topics.Split(','))
            { <span class="topics-tag">@t.Trim()</span> }
        </div>
        @if (Model.AnswersAvailable)
        {
            <div class="answers-unlocked">✅ התשובות פתוחות — ניתן לראות את כל התשובות וההסברים</div>
        }
        else if (answersAt.HasValue)
        {
            <div class="countdown-box">
                <div>
                    <div class="lbl">התשובות ייפתחו בעוד</div>
                    <div class="countdown-timer" id="timer">--:--:--</div>
                </div>
                <div style="font-size:0.8rem;color:#6b9;max-width:160px;line-height:1.5">
                    @answersAt.Value.ToString("dd/MM/yyyy")<br>בשעה @answersAt.Value.ToString("HH:mm")
                </div>
            </div>
        }
    </div>
</div>

<div class="container">
    @{
        var sections = new (string Label, List<QuizSystem.Models.Question> Questions, string Emoji, string Css)[]
        {
            ("קל",     Model.EasyQuestions,   "🟢", "easy"),
            ("בינוני", Model.MediumQuestions, "🟡", "medium"),
            ("קשה",    Model.HardQuestions,   "🔴", "hard")
        };
    }
    @foreach (var sec in sections)
    {
        <div class="section-title">
            @sec.Emoji <span>שאלות @sec.Label</span>
            <span class="badge badge-@sec.Css">@sec.Questions.Count שאלות</span>
        </div>

        @for (int i = 0; i < sec.Questions.Count; i++)
        {
            var q = sec.Questions[i];
            <div class="q-card">
                <div class="q-num">שאלה @(i+1) · @q.Topic</div>
                <div class="q-text">@q.Text</div>
                <div class="options">
                    @foreach (var opt in new[]{("A",q.OptionA),("B",q.OptionB),("C",q.OptionC),("D",q.OptionD)})
                    {
                        var isOk = Model.AnswersAvailable && q.CorrectAnswer == opt.Item1;
                        <div class="option @(isOk?"correct":"")">
                            <span class="option-key">@opt.Item1.</span>
                            <span>@opt.Item2</span>
                        </div>
                    }
                </div>
                @if (Model.AnswersAvailable)
                { <div class="explanation">💡 @q.Explanation</div> }
                else
                { <div class="locked-msg">🔒 התשובה וההסבר ייפתחו לאחר 48 שעות מרגע הרישום</div> }
            </div>
        }
    }
</div>

@if (!Model.AnswersAvailable && answersAt.HasValue)
{
    var iso = answersAt.Value.ToString("o");
    <script>
        var target = new Date('@iso');
        function tick() {
            var d = target - new Date();
            if (d <= 0) { location.reload(); return; }
            var h = Math.floor(d/3600000), m = Math.floor((d%3600000)/60000), s = Math.floor((d%60000)/1000);
            document.getElementById('timer').textContent =
                String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
        }
        tick(); setInterval(tick,1000);
    </script>
}
