@model QuizSystem.Models.QuizSession
@{ Layout="_Layout"; ViewData["Title"]="מייצר שאלות..."; }
<style>
    .gen-wrap { max-width:520px; margin:6rem auto; padding:0 1.5rem; text-align:center; }
    .spinner-ring {
        width:64px; height:64px; margin:0 auto 2rem;
        border:3px solid var(--gray-200);
        border-top-color:var(--teal);
        border-radius:50%;
        animation:spin-r 0.85s linear infinite;
    }
    @@keyframes spin-r { to { transform:rotate(360deg); } }
    .gen-wrap h1 { font-size:1.5rem; font-weight:900; color:var(--gray-900); margin-bottom:0.5rem; }
    .gen-wrap p { color:var(--gray-500); font-size:0.9rem; line-height:1.6; }
    .steps { text-align:right; margin:2rem auto 0; max-width:320px; }
    .step { display:flex; align-items:center; gap:0.75rem; padding:0.6rem 0; font-size:0.85rem; color:var(--gray-500); border-bottom:1px solid var(--gray-200); }
    .step:last-child { border-bottom:none; }
    .step-dot { width:8px; height:8px; border-radius:50%; background:var(--gray-300); flex-shrink:0; animation:pulse-r 1.5s ease-in-out infinite; }
    .step-done { background:var(--teal) !important; animation:none !important; }
    @@keyframes pulse-r { 0%,100%{opacity:0.3} 50%{opacity:1} }
</style>
<div class="gen-wrap">
    <div class="spinner-ring"></div>
    <h1>מייצרים 100 שאלות...</h1>
    <p>בונים שאלות קל, בינוני וקשה עבור:<br><strong style="color:var(--gray-900)">@Model.Topics</strong></p>
    <div class="steps">
        <div class="step"><div class="step-dot step-done"></div>נושאים התקבלו ✓</div>
        <div class="step"><div class="step-dot step-done"></div>תשלום אושר ✓</div>
        <div class="step"><div class="step-dot" style="animation-delay:0.3s"></div>34 שאלות קלות...</div>
        <div class="step"><div class="step-dot" style="animation-delay:0.7s"></div>33 שאלות בינוניות...</div>
        <div class="step"><div class="step-dot" style="animation-delay:1.1s"></div>33 שאלות קשות...</div>
    </div>
    <p style="margin-top:2rem;font-size:0.78rem;color:var(--gray-400)">הדף יתרענן אוטומטית...</p>
</div>
<script>
function check(){fetch('/Quiz/Status/@Model.Id').then(r=>r.json()).then(d=>{if(d.status==='ready')location.href='/Quiz/View/@Model.Id';}).catch(()=>{})}
setInterval(check,3000);
</script>
