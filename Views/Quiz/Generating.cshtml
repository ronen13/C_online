@model QuizSystem.Models.QuizSession
@{
    Layout = "_Layout";
    ViewData["Title"] = "מייצר שאלות...";
}
<style>
    .gen-wrap { max-width: 500px; margin: 5rem auto; padding: 0 1rem; text-align: center; }
    .spinner {
        width: 60px; height: 60px;
        border: 4px solid var(--border);
        border-top-color: var(--teal);
        border-radius: 50%;
        animation: spin-anim 0.9s linear infinite;
        margin: 0 auto 1.75rem;
    }
    @@keyframes spin-anim { to { transform: rotate(360deg); } }
    .gen-wrap h1 { font-size: 1.5rem; font-weight: 900; margin-bottom: 0.5rem; color: var(--green-deep); }
    .gen-wrap p { color: var(--text-muted); font-size: 0.95rem; }
    .steps { text-align: right; margin: 2rem auto; max-width: 320px; }
    .step { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0; font-size: 0.9rem; color: var(--text-muted); border-bottom: 1px solid var(--border); }
    .step:last-child { border-bottom: none; }
    .step .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border); flex-shrink: 0; animation: pulse-anim 1.5s ease-in-out infinite; }
    @@keyframes pulse-anim { 0%,100% { opacity:0.4; } 50% { opacity:1; } }
</style>

<div class="gen-wrap">
    <div class="spinner"></div>
    <h1>מייצרים שאלות...</h1>
    <p>בונים שאלות ברמות קל, בינוני וקשה עבור:<br><strong>@Model.Topics</strong></p>

    <div class="steps">
        <div class="step"><div class="dot" style="animation-delay:0s;background:var(--teal)"></div>נושאים התקבלו ✓</div>
        <div class="step"><div class="dot" style="animation-delay:0.2s;background:var(--teal)"></div>תשלום אושר ✓</div>
        <div class="step"><div class="dot" style="animation-delay:0.5s"></div>בונה שאלות קלות...</div>
        <div class="step"><div class="dot" style="animation-delay:0.8s"></div>בונה שאלות בינוניות...</div>
        <div class="step"><div class="dot" style="animation-delay:1.1s"></div>בונה שאלות קשות...</div>
    </div>

    <p style="font-size:0.8rem;color:var(--text-muted)">הדף יתרענן אוטומטית ברגע שהבחן מוכן...</p>
</div>

<script>
    function checkStatus() {
        fetch('/Quiz/Status/@Model.Id')
            .then(r => r.json())
            .then(data => {
                if (data.status === 'ready') window.location.href = '/Quiz/View/@Model.Id';
            })
            .catch(() => {});
    }
    setInterval(checkStatus, 3000);
</script>
