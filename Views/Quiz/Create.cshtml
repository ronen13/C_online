@{
    Layout = "_Layout";
    ViewData["Title"] = "בחן חדש";
}
<style>
    .create-wrap { max-width: 640px; margin: 3rem auto; padding: 0 1rem; }
    .create-wrap h1 { font-size: 2rem; font-weight: 900; margin-bottom: 0.4rem; }
    .create-wrap .sub { color: var(--muted); margin-bottom: 2rem; }
    .topic-hint { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }
    .price-box {
        background: var(--ink);
        color: var(--white);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 1.5rem 0;
    }
    .price-box .price { font-size: 2rem; font-weight: 900; color: var(--accent); }
    .price-box .desc { font-size: 0.85rem; color: #aaa; margin-top: 0.2rem; }
    .info-strip { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .info-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--muted);
    }
    .info-item .dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--accent);
        flex-shrink: 0;
    }
</style>

<div class="create-wrap">
    <h1>✦ יצירת בחן חדש</h1>
    <p class="sub">הכנס נושאים — אנחנו נבנה שאלות ברמות קל, בינוני וקשה</p>

    <div class="info-strip">
        <div class="info-item"><div class="dot"></div>5 שאלות בכל רמה (15 סה"כ)</div>
        <div class="info-item"><div class="dot"></div>תשובות לאחר 48 שעות</div>
        <div class="info-item"><div class="dot"></div>הסברים מפורטים</div>
    </div>

    <div class="card">
        <form method="post">
            <div class="form-group">
                <label>נושאי הבחן</label>
                <textarea name="Topics" rows="3" placeholder="לדוגמה: פיזיקה קוונטית, גלים, תנועה הרמונית" required style="resize:vertical"></textarea>
                <p class="topic-hint">הפרד נושאים בפסיק. ניתן להכניס כמה נושאים שתרצה.</p>
            </div>

            <div class="price-box">
                <div>
                    <div class="price">₪49</div>
                    <div class="desc">תשלום חד פעמי לבחן</div>
                </div>
                <div style="text-align:left; font-size:0.85rem; color:#777; max-width:180px; line-height:1.5;">
                    לאחר התשלום השאלות ייוצרו מיד. התשובות יפתחו לאחר 48 שעות.
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; font-size:1rem; padding:0.9rem;">
                המשך לתשלום ←
            </button>
        </form>
    </div>
</div>
