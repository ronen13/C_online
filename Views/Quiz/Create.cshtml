@{
    Layout = "_Layout";
    ViewData["Title"] = "בחן חדש";
}
<style>
    .create-hero { background:var(--black); padding:2.5rem 1.5rem; border-bottom:1px solid #1f2937; }
    .create-hero-inner { max-width:980px; margin:0 auto; }
    .create-hero h1 { font-size:1.75rem; font-weight:900; color:var(--white); margin-bottom:0.25rem; }
    .create-hero p { color:var(--gray-400); font-size:0.9rem; }

    .create-wrap { max-width:980px; margin:0 auto; padding:2rem 1.5rem; }

    .group-header {
        display:flex; align-items:center; gap:0.6rem;
        font-size:0.72rem; font-weight:700; letter-spacing:0.08em;
        text-transform:uppercase; color:var(--gray-400);
        margin:1.75rem 0 0.75rem; padding-bottom:0.5rem;
        border-bottom:1px solid var(--gray-200);
    }
    .group-header .gh-dot { width:6px; height:6px; border-radius:50%; background:var(--teal); }

    .topics-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(185px,1fr)); gap:0.5rem; }
    .topic-check {
        display:flex; align-items:center; gap:0.6rem;
        background:var(--white); border:1.5px solid var(--gray-200);
        border-radius:8px; padding:0.6rem 0.85rem;
        cursor:pointer; transition:all 0.12s; user-select:none;
    }
    .topic-check:hover { border-color:var(--teal); background:rgba(58,140,126,0.04); }
    .topic-check.checked { border-color:var(--teal); background:rgba(58,140,126,0.07); }
    .topic-check input[type=checkbox] { accent-color:var(--teal); width:15px; height:15px; cursor:pointer; flex-shrink:0; }
    .topic-check span { font-size:0.83rem; font-weight:500; color:var(--gray-700); line-height:1.3; }
    .topic-check.checked span { color:var(--teal-dark); }

    .summary-bar {
        position:sticky; bottom:0;
        background:var(--black);
        border-top:1px solid #2a2a2a;
        padding:1rem 1.5rem;
        display:flex; align-items:center; justify-content:space-between;
        gap:1rem;
        z-index:50;
    }
    .summary-left { display:flex; align-items:center; gap:1.5rem; }
    .summary-stat { text-align:center; }
    .summary-stat .num { font-size:1.25rem; font-weight:900; color:var(--white); }
    .summary-stat .lbl { font-size:0.7rem; color:var(--gray-500); }
    .summary-price { font-size:1.5rem; font-weight:900; color:var(--teal-light); }
    .summary-price small { font-size:0.75rem; color:var(--gray-500); display:block; text-align:center; }
    .summary-btn {
        background:var(--teal); color:var(--white);
        border:none; border-radius:8px; padding:0.7rem 1.75rem;
        font-family:'Heebo',sans-serif; font-size:0.95rem; font-weight:700;
        cursor:pointer; transition:background 0.15s; white-space:nowrap;
    }
    .summary-btn:hover { background:var(--teal-dark); }
    .summary-btn:disabled { opacity:0.4; cursor:not-allowed; }
</style>

<div class="create-hero">
    <div class="create-hero-inner">
        <h1>✦ בחן C# חדש</h1>
        <p>בחר נושאים — קבל 100 שאלות ב-3 רמות קושי</p>
    </div>
</div>

<div class="create-wrap">
    <form method="post" id="quizForm">

        <div class="group-header"><div class="gh-dot"></div>שפה ויסודות</div>
        <div class="topics-grid">
            @foreach(var t in new[]{"יסודות C# ו-.NET","טיפוסי נתונים ומשתנים","מחרוזות ו-String Manipulation","תנאים ולולאות","מערכים ו-Collections","Nullable Types"})
            { <label class="topic-check"><input type="checkbox" name="SelectedTopics" value="@t" onchange="upd(this)"><span>@t</span></label> }
        </div>

        <div class="group-header"><div class="gh-dot"></div>תכנות מונחה עצמים</div>
        <div class="topics-grid">
            @foreach(var t in new[]{"Classes ו-Objects","Inheritance","Polymorphism","Interfaces","Abstract Classes","Encapsulation","Static Members","Constructors"})
            { <label class="topic-check"><input type="checkbox" name="SelectedTopics" value="@t" onchange="upd(this)"><span>@t</span></label> }
        </div>

        <div class="group-header"><div class="gh-dot"></div>תכנות מתקדם</div>
        <div class="topics-grid">
            @foreach(var t in new[]{"LINQ","Delegates ו-Events","Lambda Expressions","Generics","Exception Handling","Extension Methods","Pattern Matching"})
            { <label class="topic-check"><input type="checkbox" name="SelectedTopics" value="@t" onchange="upd(this)"><span>@t</span></label> }
        </div>

        <div class="group-header"><div class="gh-dot"></div>Async ו-Concurrency</div>
        <div class="topics-grid">
            @foreach(var t in new[]{"async / await","Task ו-Threading","Parallel Programming","CancellationToken","Channels"})
            { <label class="topic-check"><input type="checkbox" name="SelectedTopics" value="@t" onchange="upd(this)"><span>@t</span></label> }
        </div>

        <div class="group-header"><div class="gh-dot"></div>ASP.NET Core ו-Web</div>
        <div class="topics-grid">
            @foreach(var t in new[]{"ASP.NET Core MVC","Web API ו-REST","Middleware","Dependency Injection","Authentication","Razor Pages"})
            { <label class="topic-check"><input type="checkbox" name="SelectedTopics" value="@t" onchange="upd(this)"><span>@t</span></label> }
        </div>

        <div class="group-header"><div class="gh-dot"></div>Data ו-Entity Framework</div>
        <div class="topics-grid">
            @foreach(var t in new[]{"Entity Framework Core","Migrations","Repository Pattern","CRUD Operations","Transactions"})
            { <label class="topic-check"><input type="checkbox" name="SelectedTopics" value="@t" onchange="upd(this)"><span>@t</span></label> }
        </div>

        <div class="group-header"><div class="gh-dot"></div>Architecture ו-Best Practices</div>
        <div class="topics-grid">
            @foreach(var t in new[]{"Design Patterns","SOLID Principles","Clean Architecture","Unit Testing","Records ו-Immutability","Span&lt;T&gt; ו-Memory"})
            { <label class="topic-check"><input type="checkbox" name="SelectedTopics" value="@t" onchange="upd(this)"><span>@t</span></label> }
        </div>

        <div style="height:100px"></div>

        <div class="summary-bar">
            <div class="summary-left">
                <div class="summary-stat">
                    <div class="num" id="topicCount">0</div>
                    <div class="lbl">נושאים</div>
                </div>
                <div class="summary-stat">
                    <div class="num">100</div>
                    <div class="lbl">שאלות</div>
                </div>
                <div class="summary-stat">
                    <div class="num">48h</div>
                    <div class="lbl">לתשובות</div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:1.5rem;">
                <div class="summary-price">₪99<small>לבחן</small></div>
                <button type="submit" class="summary-btn" id="submitBtn" disabled>בחר נושא ←</button>
            </div>
        </div>

    </form>
</div>

<script>
function upd(cb) {
    cb.closest('label').classList.toggle('checked', cb.checked);
    var n = document.querySelectorAll('input[name=SelectedTopics]:checked').length;
    document.getElementById('topicCount').textContent = n;
    var btn = document.getElementById('submitBtn');
    btn.disabled = n === 0;
    btn.textContent = n > 0 ? 'המשך לתשלום (' + n + ' נושאים) ←' : 'בחר נושא ←';
}
</script>
